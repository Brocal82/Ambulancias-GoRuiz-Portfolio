## Backend env (example)
## Copia a ".env" y rellena valores reales.

# ─── Críticas (obligatorias) ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=<pon-un-secreto-largo-y-aleatorio>

# Solo en NODE_ENV=test (DB aislada para tests)
MONGODB_URI_TEST=mongodb://localhost:27017/ambulancias_test

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# production | development | test

PORT=5000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=1h
JWT_EXPIRES_IN_PRIVILEGED=15m

# ─── MFA / Superadmin ────────────────────────────────────────────────────────
SUPERADMIN_MFA_REQUIRED=false
# Activar en producción: SUPERADMIN_MFA_REQUIRED=true
SUPERADMIN_MFA_ISSUER=AmbulanciasGoRuiz
STEP_UP_SESSION_TTL_SECONDS=300

# ─── Seguridad / Auditoría ────────────────────────────────────────────────────
SECURITY_MONITORING_ENABLED=true
SECURITY_MONITORING_CRON=0 7 * * *
SECURITY_MONITORING_DENIED_THRESHOLD=3
SECURITY_AUDIT_LOG_RETENTION_DAYS=180

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REPORT_ISSUE_MAX=10
RATE_LIMIT_REPORT_ISSUE_WINDOW_MS=60000

# ─── Funcionalidad ────────────────────────────────────────────────────────────
PSCHEIN_WARNING_MONTHS=6
