{
  "name": "ambulancias-goruiz-backend",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy:openapi",
    "copy:openapi": "node ../scripts/copy-openapi.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "create:users": "ts-node scripts/createUsers.ts",
    "bootstrap:superadmin": "ts-node scripts/bootstrap-superadmin.ts",
    "create:superadmin": "ts-node scripts/createSuperAdmin.ts",
    "delete:users": "ts-node scripts/deleteAllUsers.ts",
    "reset:users": "ts-node scripts/resetUsers.ts",
    "create:hospitals": "ts-node scripts/createHospitals.ts",
    "delete:hospitals": "ts-node scripts/deleteHospitals.ts",
    "create:ambulances": "ts-node scripts/createAmbulances.ts",
    "delete:ambulances": "ts-node scripts/deleteAllAmbulances.ts",
    "delete:uploads": "ts-node scripts/deleteUnusedUploads.ts",
    "cleanup:test-data": "ts-node scripts/cleanupTestDataFromDev.ts",
    "seed:test-workers": "ts-node scripts/seed-test-workers.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:security:isolation": "jest --runInBand src/__tests__/operational.isolation.test.ts src/__tests__/multi-tenant.isolation.test.ts src/__tests__/files.security.integration.test.ts src/__tests__/support-access.integration.test.ts",
    "test:security:isolation:ci": "jest --ci --runInBand src/__tests__/operational.isolation.test.ts src/__tests__/multi-tenant.isolation.test.ts src/__tests__/files.security.integration.test.ts src/__tests__/support-access.integration.test.ts",
    "security:report:daily": "ts-node --transpile-only src/scripts/run-security-monitoring-report.ts",
    "backfill:company-modules": "ts-node src/scripts/backfill-company-modules.ts",
    "backfill:excel-planning-module": "ts-node src/scripts/backfill-company-module-excel-planning.ts",
    "generate:excel-planning-real": "ts-node scripts/generate-excel-planning-real-workers.ts",
    "sample:excels-villanos-avengers": "node scripts/generate-sample-excels-villanos-avengers.js",
    "cleanup:excel-planning-discarded": "ts-node src/scripts/cleanup-excel-planning-discarded-imports.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/speakeasy": "^2.0.10",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.14.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "speakeasy": "^2.0.0",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/luxon": "^3.7.1",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.12",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.3.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
