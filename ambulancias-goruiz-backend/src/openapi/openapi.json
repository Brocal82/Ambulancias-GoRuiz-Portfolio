{
  "openapi": "3.0.3",
  "info": {
    "title": "Ambulancias GoRuiz API",
    "description": "Minimal OpenAPI surface — health, login, and hospitals. Full reference: docs/API-REFERENCE.md",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/", "description": "Backend root (adjust host/port in deployment)" }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns server and MongoDB connection status. No authentication.",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthOk" }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthDown" }
              }
            }
          }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "summary": "Login",
        "description": "Authenticates with email and password. Rate limited (5 attempts / 15 min per IP). Superadmin may require MFA when SUPERADMIN_MFA_REQUIRED is enabled.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginSuccess" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or MFA required/invalid",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": {
            "description": "Account or company inactive, MFA not enrolled",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "409": {
            "description": "MFA configuration invalid",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/api/hospitals": {
      "get": {
        "summary": "List hospitals",
        "description": "Requires module `hospitals`. Admin and worker roles.",
        "tags": ["Hospitals"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Hospital list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Hospital" }
                }
              }
            }
          },
          "403": { "description": "Module disabled or missing company", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "post": {
        "summary": "Create hospital",
        "description": "Admin only. Body validated with Zod (trim, non-empty strings).",
        "tags": ["Hospitals"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/HospitalCreateRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hospital" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/hospitals/{id}": {
      "put": {
        "summary": "Update hospital (full/partial body)",
        "tags": ["Hospitals"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/HospitalUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hospital" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "patch": {
        "summary": "Partial update hospital",
        "description": "Same schema and handler as PUT; only sent fields are updated.",
        "tags": ["Hospitals"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/HospitalUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hospital" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "delete": {
        "summary": "Delete hospital",
        "description": "Returns 409 if referenced in trips or workday-summary toAddress (exact name/address match).",
        "tags": ["Hospitals"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "409": { "description": "In use", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HospitalDeleteConflict" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthOk": {
        "type": "object",
        "required": ["status", "uptime", "db"],
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "uptime": { "type": "number", "description": "Process uptime in seconds" },
          "db": { "type": "string", "enum": ["ok"] }
        }
      },
      "HealthDown": {
        "type": "object",
        "required": ["status", "uptime", "db"],
        "properties": {
          "status": { "type": "string", "enum": ["down"] },
          "uptime": { "type": "number" },
          "db": { "type": "string", "enum": ["down"] }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 1 },
          "mfaCode": { "type": "string", "description": "Optional 6-digit TOTP for superadmin MFA" }
        }
      },
      "LoginSuccess": {
        "type": "object",
        "required": ["message", "token", "user"],
        "properties": {
          "message": { "type": "string", "example": "Login exitoso" },
          "token": { "type": "string", "description": "JWT Bearer token" },
          "user": { "$ref": "#/components/schemas/LoginUser" }
        }
      },
      "LoginUser": {
        "type": "object",
        "required": ["_id", "name", "lastName", "email", "role"],
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string" },
          "companyId": { "type": "string" },
          "ambulanceRole": { "type": "string" },
          "employeeNumber": { "type": "string" },
          "profileImage": { "type": "string" }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": { "message": { "type": "string" } }
      },
      "AuthErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "code": { "type": "string", "description": "e.g. MFA_REQUIRED, MFA_INVALID, COMPANY_INACTIVE" }
        }
      },
      "Hospital": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string" },
          "address": { "type": "string" },
          "phone": { "type": "string" },
          "specialties": { "type": "array", "items": { "type": "string" } },
          "isOpen": { "type": "boolean" },
          "companyId": { "type": "string" }
        }
      },
      "HospitalCreateRequest": {
        "type": "object",
        "required": ["name", "address", "phone", "specialties"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "address": { "type": "string", "minLength": 1 },
          "phone": { "type": "string", "minLength": 1 },
          "specialties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "isOpen": { "type": "boolean" }
        }
      },
      "HospitalUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "address": { "type": "string", "minLength": 1 },
          "phone": { "type": "string", "minLength": 1 },
          "specialties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "isOpen": { "type": "boolean" }
        }
      },
      "HospitalDeleteConflict": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "sources": {
            "type": "array",
            "items": { "type": "string", "enum": ["trips", "workday-summary"] }
          }
        }
      }
    }
  }
}
