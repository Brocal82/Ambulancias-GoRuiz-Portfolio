{
  "openapi": "3.0.3",
  "info": {
    "title": "Ambulancias GoRuiz API",
    "description": "Minimal OpenAPI surface — health, login, hospitals, ambulances, teams, and appointments. Full reference: docs/API-REFERENCE.md",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/", "description": "Backend root (adjust host/port in deployment)" }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns server and MongoDB connection status. No authentication.",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthOk" }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthDown" }
              }
            }
          }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "summary": "Login",
        "description": "Authenticates with email and password. Rate limited (5 attempts / 15 min per IP). Superadmin may require MFA when SUPERADMIN_MFA_REQUIRED is enabled.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginSuccess" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or MFA required/invalid",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": {
            "description": "Account or company inactive, MFA not enrolled",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "409": {
            "description": "MFA configuration invalid",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/api/hospitals": {
      "get": {
        "summary": "List hospitals",
        "description": "Requires module `hospitals`. Admin and worker roles.",
        "tags": ["Hospitals"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Hospital list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Hospital" }
                }
              }
            }
          },
          "403": { "description": "Module disabled or missing company", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "post": {
        "summary": "Create hospital",
        "description": "Admin only. Body validated with Zod (trim, non-empty strings).",
        "tags": ["Hospitals"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/HospitalCreateRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hospital" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/hospitals/{id}": {
      "put": {
        "summary": "Update hospital (full/partial body)",
        "tags": ["Hospitals"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/HospitalUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hospital" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "patch": {
        "summary": "Partial update hospital",
        "description": "Same schema and handler as PUT; only sent fields are updated.",
        "tags": ["Hospitals"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/HospitalUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hospital" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "delete": {
        "summary": "Delete hospital",
        "description": "Returns 409 if referenced in trips or workday-summary toAddress (exact name/address match).",
        "tags": ["Hospitals"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "409": { "description": "In use", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HospitalDeleteConflict" } } } }
        }
      }
    },
    "/api/ambulances": {
      "get": {
        "summary": "List ambulances",
        "description": "Requires module `ambulances`. Admin, worker, and other roles with company context.",
        "tags": ["Ambulances"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Ambulance list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Ambulance" }
                }
              }
            }
          },
          "403": { "description": "Module disabled or missing company", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "post": {
        "summary": "Create ambulance",
        "description": "Admin or jefe_mecanicos. Body validated with Zod (strict). `companyId` is derived from JWT, not from body.",
        "tags": ["Ambulances"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AmbulanceCreateRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ambulance" } } } },
          "400": { "description": "Validation or duplicate key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/ambulances/{id}": {
      "get": {
        "summary": "Get ambulance by id",
        "tags": ["Ambulances"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Ambulance", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ambulance" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "put": {
        "summary": "Update ambulance",
        "description": "Admin or jefe_mecanicos.",
        "tags": ["Ambulances"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AmbulanceUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ambulance" } } } },
          "400": { "description": "Validation or duplicate key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "delete": {
        "summary": "Delete ambulance",
        "description": "Admin or jefe_mecanicos. Returns 409 with `sources` if referenced in dienst assignments, teams, workday-summary, mechanics work orders/issues, or trip-setup.",
        "tags": ["Ambulances"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "409": { "description": "In use", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AmbulanceDeleteConflict" } } } }
        }
      }
    },
    "/api/teams": {
      "get": {
        "summary": "List teams",
        "description": "Requires module `teams`. Admin only. Scoped by JWT companyId.",
        "tags": ["Teams"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Team list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Team" }
                }
              }
            }
          },
          "403": { "description": "Module disabled or missing company", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "post": {
        "summary": "Create team",
        "description": "Admin only. Driver must have ambulanceRole driver|both; medic medic|both. `companyId` from JWT.",
        "tags": ["Teams"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TeamCreateRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Team" } } } },
          "400": { "description": "Validation or invalid ambulance roles", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "409": { "description": "Duplicate pair or member already in another team", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/teams/used-for-week": {
      "get": {
        "summary": "Teams used in a week",
        "description": "Returns team IDs whose driver+medic pair appears in Dienst assignments for the given weekStartDate (YYYY-MM-DD). Requires module `teams`.",
        "tags": ["Teams"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "weekStartDate",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "Used team IDs",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsedTeamsForWeekResponse" }
              }
            }
          },
          "400": { "description": "Missing or invalid weekStartDate", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Module disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/teams/{id}": {
      "patch": {
        "summary": "Update team",
        "description": "Admin only. Uses PATCH (not PUT). Full body with driver, medic, rotationMode, optional fixedDienstNumber and ambulanceId.",
        "tags": ["Teams"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TeamUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Team" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "409": { "description": "Conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "delete": {
        "summary": "Delete team",
        "description": "Admin only. Returns 409 with `sources` if referenced by Dienst.weekTeamId (`dienst-week-team`).",
        "tags": ["Teams"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "409": { "description": "In use", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TeamDeleteConflict" } } } }
        }
      }
    },
    "/api/appointments/requests": {
      "post": {
        "summary": "Create appointment request (worker)",
        "description": "Requires module `appointments`. Creates a request with status `pending`. Worker only.",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AppointmentRequestCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Appointment" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Module disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/my": {
      "get": {
        "summary": "List my appointments (worker)",
        "description": "Returns all appointments for the authenticated worker. Requires module `appointments`.",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Appointment list",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Appointment" } }
              }
            }
          },
          "403": { "description": "Module disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/pending": {
      "get": {
        "summary": "List pending appointments (admin)",
        "description": "Admin only. Status `pending`, scoped by JWT companyId (legacy null companyId resolved via worker).",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Pending appointments",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Appointment" } }
              }
            }
          },
          "403": { "description": "Forbidden or module disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/open": {
      "get": {
        "summary": "List open appointments (admin)",
        "description": "Admin only. Status in `pending`, `proposed`, `cancellation_requested`. Scoped by companyId.",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Open appointments",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Appointment" } }
              }
            }
          },
          "403": { "description": "Forbidden or module disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/count": {
      "get": {
        "summary": "Count appointments by status (admin)",
        "description": "Admin only. Query `status` defaults to `pending`. Valid statuses: pending, proposed, confirmed, cancelled, rescheduled, cancellation_requested.",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/AppointmentStatus" }
          }
        ],
        "responses": {
          "200": {
            "description": "Count",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AppointmentCountResponse" }
              }
            }
          },
          "400": { "description": "Invalid status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden or module disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/calendar": {
      "get": {
        "summary": "Calendar appointments in range (admin)",
        "description": "Admin only. Returns confirmed/rescheduled appointments whose selectedSlot.start falls within `from`–`to` (ISO). Both query params required.",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "from", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": {
            "description": "Calendar appointments",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Appointment" } }
              }
            }
          },
          "400": { "description": "Missing or invalid date range", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden or module disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/{id}": {
      "patch": {
        "summary": "Update appointment (admin)",
        "description": "Admin only. PATCH (not PUT). Optional fields: reason, details, selectedSlot. Providing selectedSlot sets status to `rescheduled`. At least one field required. Scoped by companyId.",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AppointmentUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Appointment" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      },
      "delete": {
        "summary": "Cancel appointment (admin)",
        "description": "Admin only. Sets status to `cancelled`. Scoped by companyId.",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Cancelled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Appointment" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/{id}/propose": {
      "post": {
        "summary": "Propose time slots (admin)",
        "description": "Admin only. 1–3 future slots, ordered ascending by start. Sets status to `proposed`. From `pending` or `proposed`.",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AppointmentProposeRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Proposed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Appointment" } } } },
          "400": { "description": "Validation or invalid status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/{id}/select": {
      "post": {
        "summary": "Select proposed slot (worker)",
        "description": "Worker only. selectedSlot must match one of proposedSlots. Sets status to `confirmed`.",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AppointmentSelectRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Confirmed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Appointment" } } } },
          "400": { "description": "Validation or slot mismatch", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/{id}/reject-proposal": {
      "post": {
        "summary": "Reject proposal (worker)",
        "description": "Worker only. From `proposed` back to `pending` (clears proposedSlots).",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Back to pending", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Appointment" } } } },
          "400": { "description": "Invalid status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/{id}/request-cancel": {
      "post": {
        "summary": "Request cancellation (worker)",
        "description": "Worker only. Sets status to `cancellation_requested` with a message (max 1000 chars).",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AppointmentCancellationRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Cancellation requested", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Appointment" } } } },
          "400": { "description": "Validation or invalid status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/{id}/accept-cancel": {
      "post": {
        "summary": "Accept cancellation (admin)",
        "description": "Admin only. From `cancellation_requested` to `cancelled`. Scoped by companyId.",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Cancelled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Appointment" } } } },
          "400": { "description": "No pending cancellation request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    },
    "/api/appointments/{id}/my": {
      "delete": {
        "summary": "Delete own cancelled appointment (worker)",
        "description": "Worker only. Allowed only when status is already `cancelled`.",
        "tags": ["Appointments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Deleted" },
          "400": { "description": "Not cancelled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "403": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthOk": {
        "type": "object",
        "required": ["status", "uptime", "db"],
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "uptime": { "type": "number", "description": "Process uptime in seconds" },
          "db": { "type": "string", "enum": ["ok"] }
        }
      },
      "HealthDown": {
        "type": "object",
        "required": ["status", "uptime", "db"],
        "properties": {
          "status": { "type": "string", "enum": ["down"] },
          "uptime": { "type": "number" },
          "db": { "type": "string", "enum": ["down"] }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 1 },
          "mfaCode": { "type": "string", "description": "Optional 6-digit TOTP for superadmin MFA" }
        }
      },
      "LoginSuccess": {
        "type": "object",
        "required": ["message", "token", "user"],
        "properties": {
          "message": { "type": "string", "example": "Login exitoso" },
          "token": { "type": "string", "description": "JWT Bearer token" },
          "user": { "$ref": "#/components/schemas/LoginUser" }
        }
      },
      "LoginUser": {
        "type": "object",
        "required": ["_id", "name", "lastName", "email", "role"],
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string" },
          "companyId": { "type": "string" },
          "ambulanceRole": { "type": "string" },
          "employeeNumber": { "type": "string" },
          "profileImage": { "type": "string" }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": { "message": { "type": "string" } }
      },
      "AuthErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "code": { "type": "string", "description": "e.g. MFA_REQUIRED, MFA_INVALID, COMPANY_INACTIVE" }
        }
      },
      "Hospital": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string" },
          "address": { "type": "string" },
          "phone": { "type": "string" },
          "specialties": { "type": "array", "items": { "type": "string" } },
          "isOpen": { "type": "boolean" },
          "companyId": { "type": "string" }
        }
      },
      "HospitalCreateRequest": {
        "type": "object",
        "required": ["name", "address", "phone", "specialties"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "address": { "type": "string", "minLength": 1 },
          "phone": { "type": "string", "minLength": 1 },
          "specialties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "isOpen": { "type": "boolean" }
        }
      },
      "HospitalUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "address": { "type": "string", "minLength": 1 },
          "phone": { "type": "string", "minLength": 1 },
          "specialties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "isOpen": { "type": "boolean" }
        }
      },
      "HospitalDeleteConflict": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "sources": {
            "type": "array",
            "items": { "type": "string", "enum": ["trips", "workday-summary"] }
          }
        }
      },
      "Ambulance": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "brand": { "type": "string" },
          "modelName": { "type": "string" },
          "licensePlate": { "type": "string" },
          "ambulanceNumber": { "type": "string" },
          "companyId": { "type": "string" }
        }
      },
      "AmbulanceCreateRequest": {
        "type": "object",
        "required": ["brand", "modelName", "licensePlate", "ambulanceNumber"],
        "additionalProperties": false,
        "properties": {
          "brand": { "type": "string", "minLength": 1 },
          "modelName": { "type": "string", "minLength": 1 },
          "licensePlate": { "type": "string", "minLength": 1 },
          "ambulanceNumber": { "type": "string", "minLength": 1 }
        }
      },
      "AmbulanceUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "brand": { "type": "string", "minLength": 1 },
          "modelName": { "type": "string", "minLength": 1 },
          "licensePlate": { "type": "string", "minLength": 1 },
          "ambulanceNumber": { "type": "string", "minLength": 1 }
        }
      },
      "AmbulanceDeleteConflict": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "dienst-assignments",
                "teams",
                "workday-summary",
                "mechanics-work-orders",
                "mechanics-issues",
                "trip-setup"
              ]
            }
          }
        }
      },
      "Team": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "driver": { "type": "object" },
          "medic": { "type": "object" },
          "rotationMode": { "type": "string", "enum": ["rotating", "fixed", "none"] },
          "fixedDienstNumber": { "type": "integer", "nullable": true },
          "ambulanceId": { "type": "object", "nullable": true },
          "companyId": { "type": "string" }
        }
      },
      "TeamCreateRequest": {
        "type": "object",
        "required": ["driver", "medic"],
        "properties": {
          "driver": { "type": "string", "description": "User ObjectId" },
          "medic": { "type": "string", "description": "User ObjectId" },
          "rotationMode": { "type": "string", "enum": ["rotating", "fixed", "none"] },
          "fixedDienstNumber": { "type": "integer", "minimum": 1 },
          "ambulanceId": { "type": "string", "nullable": true }
        }
      },
      "TeamUpdateRequest": {
        "type": "object",
        "required": ["driver", "medic"],
        "properties": {
          "driver": { "type": "string" },
          "medic": { "type": "string" },
          "rotationMode": { "type": "string", "enum": ["rotating", "fixed", "none"] },
          "fixedDienstNumber": { "type": "integer", "minimum": 1, "nullable": true },
          "ambulanceId": { "type": "string", "nullable": true }
        }
      },
      "UsedTeamsForWeekResponse": {
        "type": "object",
        "properties": {
          "usedTeamIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "TeamDeleteConflict": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "sources": {
            "type": "array",
            "items": { "type": "string", "enum": ["dienst-week-team"] }
          }
        }
      },
      "AppointmentStatus": {
        "type": "string",
        "enum": ["pending", "proposed", "confirmed", "cancelled", "rescheduled", "cancellation_requested"],
        "description": "Workflow: pending → proposed → confirmed | rescheduled; cancellation_requested → cancelled; admin/worker cancel paths also set cancelled."
      },
      "AppointmentTimeSlot": {
        "type": "object",
        "required": ["start", "end"],
        "properties": {
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" }
        }
      },
      "Appointment": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "workerId": { "type": "string" },
          "adminId": { "type": "string" },
          "companyId": { "type": "string", "nullable": true },
          "reason": { "type": "string", "maxLength": 120 },
          "details": { "type": "string", "maxLength": 5000 },
          "status": { "$ref": "#/components/schemas/AppointmentStatus" },
          "proposedSlots": { "type": "array", "items": { "$ref": "#/components/schemas/AppointmentTimeSlot" }, "maxItems": 3 },
          "selectedSlot": { "$ref": "#/components/schemas/AppointmentTimeSlot", "nullable": true },
          "cancellationMessage": { "type": "string", "maxLength": 1000 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AppointmentRequestCreate": {
        "type": "object",
        "required": ["reason", "details"],
        "properties": {
          "reason": { "type": "string", "minLength": 1, "maxLength": 120 },
          "details": { "type": "string", "minLength": 1, "maxLength": 5000 }
        }
      },
      "AppointmentProposeRequest": {
        "type": "object",
        "required": ["proposedSlots"],
        "properties": {
          "proposedSlots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "$ref": "#/components/schemas/AppointmentTimeSlot" },
            "description": "Future slots ordered ascending by start; each start < end."
          }
        }
      },
      "AppointmentSelectRequest": {
        "type": "object",
        "required": ["selectedSlot"],
        "properties": {
          "selectedSlot": { "$ref": "#/components/schemas/AppointmentTimeSlot" }
        }
      },
      "AppointmentUpdateRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "reason": { "type": "string", "minLength": 1, "maxLength": 120 },
          "details": { "type": "string", "minLength": 1, "maxLength": 5000 },
          "selectedSlot": { "$ref": "#/components/schemas/AppointmentTimeSlot", "description": "When set, status becomes rescheduled." }
        }
      },
      "AppointmentCancellationRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      },
      "AppointmentCountResponse": {
        "type": "object",
        "required": ["count"],
        "properties": {
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
