# Worker app (Expo) — copy to .env.local (gitignored) and adjust.
#
# Backend API root. Optional in development: if unset, the app derives
# http://<your-dev-machine-LAN-IP>:5000/api from the Expo dev server (hostUri).
# Required for production/store builds: must be a public HTTPS URL.
# Examples:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:5000/api   (physical device, local backend)
#   EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api    (production)
EXPO_PUBLIC_API_BASE_URL=
